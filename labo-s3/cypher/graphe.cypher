MATCH (c:Client {id: 2052}), (p:Produit {id: 'P-205'}) MERGE (c)-[:A_ACHETE {date: date('2026-09-25'), quantite: 3, commande: 'CMD-0355'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-112'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-02'), quantite: 2, commande: 'CMD-0391'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-205'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-02'), quantite: 2, commande: 'CMD-0391'}]->(p);

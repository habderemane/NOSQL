MATCH (c:Client {id: 3311}), (p:Produit {id: 'P-520'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-07'), quantite: 2, commande: 'CMD-0410'}]->(p);
MATCH (c:Client {id: 3311}), (p:Produit {id: 'P-610'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-07'), quantite: 1, commande: 'CMD-0410'}]->(p);
MATCH (c:Client {id: 4100}), (p:Produit {id: 'P-112'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-11'), quantite: 1, commande: 'CMD-0428'}]->(p);
MATCH (c:Client {id: 4100}), (p:Produit {id: 'P-340'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-11'), quantite: 1, commande: 'CMD-0428'}]->(p);
MATCH (c:Client {id: 4101}), (p:Produit {id: 'P-778'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-13'), quantite: 1, commande: 'CMD-0436'}]->(p);
MATCH (c:Client {id: 4101}), (p:Produit {id: 'P-112'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-13'), quantite: 1, commande: 'CMD-0436'}]->(p);
MATCH (c:Client {id: 4101}), (p:Produit {id: 'P-340'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-13'), quantite: 1, commande: 'CMD-0436'}]->(p);
MATCH (c:Client {id: 4101}), (p:Produit {id: 'P-610'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-13'), quantite: 1, commande: 'CMD-0436'}]->(p);
MATCH (c:Client {id: 5200}), (p:Produit {id: 'P-205'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-16'), quantite: 2, commande: 'CMD-0449'}]->(p);
MATCH (c:Client {id: 5200}), (p:Produit {id: 'P-520'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-16'), quantite: 1, commande: 'CMD-0449'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-778'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-19'), quantite: 2, commande: 'CMD-0457'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-112'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-19'), quantite: 1, commande: 'CMD-0457'}]->(p);
MATCH (c:Client {id: 2051}), (p:Produit {id: 'P-340'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-21'), quantite: 4, commande: 'CMD-0466'}]->(p);
MATCH (c:Client {id: 3310}), (p:Produit {id: 'P-520'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-23'), quantite: 1, commande: 'CMD-0471'}]->(p);
MATCH (c:Client {id: 3310}), (p:Produit {id: 'P-340'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-23'), quantite: 1, commande: 'CMD-0471'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-778'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-24'), quantite: 1, commande: 'CMD-0480'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-520'}) MERGE (c)-[:A_ACHETE {date: date('2026-10-24'), quantite: 1, commande: 'CMD-0480'}]->(p);
MATCH (n) RETURN labels(n)[0] AS type, count(*) AS nombre ORDER BY type;

// Labo S3 — partie 6.4 : graphe d’achats de Teranga Shop, construit à partir des 13 commandes de référence
// Commande : docker exec -it s3-neo4j cypher-shell -u neo4j -p teranga2026 -f /scripts/graphe.cypher
CREATE CONSTRAINT client_id IF NOT EXISTS FOR (c:Client) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT produit_id IF NOT EXISTS FOR (p:Produit) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT ville_nom IF NOT EXISTS FOR (v:Ville) REQUIRE v.nom IS UNIQUE;
MERGE (:Ville {nom: 'Dakar'});
MERGE (:Ville {nom: 'Kaolack'});
MERGE (:Ville {nom: 'Kolda'});
MERGE (:Ville {nom: 'Louga'});
MERGE (:Ville {nom: 'Mbour'});
MERGE (:Ville {nom: 'Saint-Louis'});
MERGE (:Ville {nom: 'Thiès'});
MERGE (:Ville {nom: 'Touba'});
MERGE (:Ville {nom: 'Ziguinchor'});
MERGE (c:Client {id: 1024}) SET c.nom = 'Awa Diop' WITH c MATCH (v:Ville {nom: 'Thiès'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 1025}) SET c.nom = 'Ibou Sarr' WITH c MATCH (v:Ville {nom: 'Dakar'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 2051}) SET c.nom = 'Fatou Ndiaye' WITH c MATCH (v:Ville {nom: 'Saint-Louis'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 2052}) SET c.nom = 'Moussa Fall' WITH c MATCH (v:Ville {nom: 'Kaolack'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 3310}) SET c.nom = 'Aminata Ba' WITH c MATCH (v:Ville {nom: 'Ziguinchor'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 3311}) SET c.nom = 'Cheikh Diallo' WITH c MATCH (v:Ville {nom: 'Kolda'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 4100}) SET c.nom = 'Mariama Sow' WITH c MATCH (v:Ville {nom: 'Touba'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 4101}) SET c.nom = 'Ousmane Gueye' WITH c MATCH (v:Ville {nom: 'Mbour'}) MERGE (c)-[:HABITE]->(v);
MERGE (c:Client {id: 5200}) SET c.nom = 'Khady Faye' WITH c MATCH (v:Ville {nom: 'Louga'}) MERGE (c)-[:HABITE]->(v);
MERGE (p:Produit {id: 'P-778'}) SET p.nom = 'Riz parfumé 25 kg', p.prix = 18500;
MERGE (p:Produit {id: 'P-112'}) SET p.nom = 'Huile 5 L', p.prix = 6500;
MERGE (p:Produit {id: 'P-205'}) SET p.nom = 'Sucre 1 kg', p.prix = 1000;
MERGE (p:Produit {id: 'P-340'}) SET p.nom = 'Café Touba 500 g', p.prix = 3000;
MERGE (p:Produit {id: 'P-520'}) SET p.nom = 'Thé vert 200 g', p.prix = 2500;
MERGE (p:Produit {id: 'P-610'}) SET p.nom = 'Lait en poudre 400 g', p.prix = 2750;
MATCH (c:Client {id: 3310}), (p:Produit {id: 'P-778'}) MERGE (c)-[:A_ACHETE {date: date('2026-08-30'), quantite: 1, commande: 'CMD-0244'}]->(p);
MATCH (c:Client {id: 3310}), (p:Produit {id: 'P-112'}) MERGE (c)-[:A_ACHETE {date: date('2026-08-30'), quantite: 1, commande: 'CMD-0244'}]->(p);
MATCH (c:Client {id: 3310}), (p:Produit {id: 'P-205'}) MERGE (c)-[:A_ACHETE {date: date('2026-08-30'), quantite: 2, commande: 'CMD-0244'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-340'}) MERGE (c)-[:A_ACHETE {date: date('2026-09-14'), quantite: 2, commande: 'CMD-0302'}]->(p);
MATCH (c:Client {id: 1024}), (p:Produit {id: 'P-205'}) MERGE (c)-[:A_ACHETE {date: date('2026-09-14'), quantite: 2, commande: 'CMD-0302'}]->(p);
MATCH (c:Client {id: 1025}), (p:Produit {id: 'P-778'}) MERGE (c)-[:A_ACHETE {date: date('2026-09-16'), quantite: 1, commande: 'CMD-0312'}]->(p);
MATCH (c:Client {id: 1025}), (p:Produit {id: 'P-112'}) MERGE (c)-[:A_ACHETE {date: date('2026-09-16'), quantite: 1, commande: 'CMD-0312'}]->(p);
MATCH (c:Client {id: 1025}), (p:Produit {id: 'P-610'}) MERGE (c)-[:A_ACHETE {date: date('2026-09-16'), quantite: 2, commande: 'CMD-0312'}]->(p);
